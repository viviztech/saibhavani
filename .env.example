# Copy to .env.local for local use. Never commit real credentials.
# Canonical public origin; use https in production. No trailing path.
APP_URL=http://localhost:3000

# Use DATABASE_URL or the individual connection fields below.
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Required in production; TLS certificate and hostname are verified.
DB_SSL=false
# Optional PEM CA for a database with a private CA; use escaped newlines.
DB_SSL_CA=

# Optional. Tracking only loads after a visitor opts in.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
